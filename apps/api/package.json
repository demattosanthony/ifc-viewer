{
  "name": "@ifc-viewer/api",
  "version": "0.1.0",
  "private": true,
  "description": "Elysia API server for IFC Viewer",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "elysia": "^1.2.0",
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/swagger": "^1.2.0",
    "@ifc-viewer/core": "workspace:*",
    "@ifc-viewer/database": "workspace:*",
    "@ifc-viewer/storage": "workspace:*",
    "@ifc-viewer/compute": "workspace:*",
    "@ifc-viewer/agent": "workspace:*",
    "@ifc-viewer/realtime": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
