{
  "name": "@ifc-viewer/server",
  "version": "0.1.0",
  "private": true,
  "description": "Elysia server for IFC Viewer (HTTP + WebSocket)",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "start": "bun run --hot src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/openapi": "^1.4.13",
    "@ifc-viewer/core": "workspace:*",
    "@ifc-viewer/infrastructure": "workspace:*",
    "@ifc-viewer/interface": "workspace:*",
    "@ifc-viewer/realtime": "workspace:*",
    "elysia": "^1.2.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
