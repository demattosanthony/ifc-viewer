{
  "name": "@ifc-viewer/monorepo",
  "private": true,
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun --env-file=.env --filter=@ifc-viewer/server run start",
    "dev:web": "bun --env-file=.env --filter=@ifc-viewer/web run dev",
    "build": "bun --filter=@ifc-viewer/server run build && bun --filter=@ifc-viewer/web run build",
    "typecheck": "bun --filter=* run typecheck",
    "generate:sdk": "bun --filter=@ifc-viewer/sdk run generate",
    "fetch:openapi": "bun --filter=@ifc-viewer/sdk run fetch-spec",
    "ui:add": "bunx shadcn@latest add --cwd apps/web",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "docker:build:bim-ide": "docker build -t bim-ide:latest ./containers/bim-ide"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/stats.js": "^0.17.4"
  }
}
