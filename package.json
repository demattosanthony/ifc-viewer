{
  "name": "@ifc-viewer/monorepo",
  "private": true,
  "scripts": {
    "dev": "bun --filter=@ifc-viewer/api run start & bun --filter=@ifc-viewer/web run dev",
    "dev:api": "bun --filter=@ifc-viewer/api run start",
    "dev:web": "bun --filter=@ifc-viewer/web run dev",
    "build": "bun --filter=@ifc-viewer/api run build && bun --filter=@ifc-viewer/web run build",
    "typecheck": "bun --filter=* run typecheck",
    "generate:sdk": "bun --filter=@ifc-viewer/sdk run generate",
    "fetch:openapi": "bun --filter=@ifc-viewer/sdk run fetch-spec",
    "ui:add": "bunx shadcn@latest add --cwd apps/web"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/stats.js": "^0.17.4"
  }
}
