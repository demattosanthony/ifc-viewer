# =============================================================================
# IFC Viewer Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# All apps and packages read from this single root .env file

# -----------------------------------------------------------------------------
# AI (Required)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Postgres connection string - if not set, falls back to SQLite
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ifc_viewer

# SQLite data directory (only used if DATABASE_URL is not set)
# DATA_DIR=.data/sqlite

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Local storage directory for project files
STORAGE_LOCAL_BASE_DIR=.data/storage

# -----------------------------------------------------------------------------
# Compute
# -----------------------------------------------------------------------------
# Working directory for workspace file operations
PLAYGROUND_WORKING_DIR=.data/workspace

# Compute provider: "docker" (default) or "local"
# - docker: Uses Docker containers for isolated compute (requires Docker + bim-ide image)
# - local: Uses local filesystem and shell (no isolation, but no Docker required)
COMPUTE_PROVIDER=docker

# Docker image for compute provider (only used when COMPUTE_PROVIDER=docker)
DOCKER_IMAGE=bim-ide:latest

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------------------
# Web (Vite)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000
