# IFC Viewer Environment Configuration
# Copy to .env and fill in values

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Database ---
# Postgres connection (falls back to SQLite if not set)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ifc_viewer

# --- Storage ---
STORAGE_LOCAL_BASE_DIR=.data/storage

# --- Compute ---
# Provider: "docker" (isolated containers) or "local" (no Docker required)
COMPUTE_PROVIDER=docker
DOCKER_IMAGE=bim-ide:latest

# --- Logging ---
LOG_LEVEL=info                # debug | info | warn | error
LOG_DIR=.data/logs
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# --- Server ---
PORT=3000

# --- Web ---
VITE_API_URL=http://localhost:3000
