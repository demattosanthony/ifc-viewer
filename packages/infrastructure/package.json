{
  "name": "@ifc-viewer/infrastructure",
  "version": "0.1.0",
  "private": true,
  "description": "Infrastructure layer for IFC Viewer - repositories, storage adapters, and compute providers",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate:sqlite": "drizzle-kit generate --config=src/database/sqlite/drizzle.config.ts",
    "db:generate:postgres": "drizzle-kit generate --config=src/database/postgres/drizzle.config.ts",
    "db:migrate:sqlite": "drizzle-kit migrate --config=src/database/sqlite/drizzle.config.ts",
    "db:migrate:postgres": "drizzle-kit migrate --config=src/database/postgres/drizzle.config.ts",
    "db:studio:sqlite": "drizzle-kit studio --config=src/database/sqlite/drizzle.config.ts",
    "db:studio:postgres": "drizzle-kit studio --config=src/database/postgres/drizzle.config.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./database": "./src/database/index.ts",
    "./storage": "./src/storage/index.ts",
    "./compute": "./src/compute/index.ts"
  },
  "dependencies": {
    "@ifc-viewer/core": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/uuid": "^11.0.0",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5"
  }
}
