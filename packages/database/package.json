{
  "name": "@ifc-viewer/database",
  "version": "0.1.0",
  "private": true,
  "description": "Database implementations for IFC Viewer",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:generate:pg": "drizzle-kit generate --config=drizzle-pg.config.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:pg": "drizzle-kit migrate --config=drizzle-pg.config.ts",
    "db:studio": "drizzle-kit studio",
    "db:studio:pg": "drizzle-kit studio --config=drizzle-pg.config.ts"
  },
  "dependencies": {
    "@ifc-viewer/core": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/uuid": "^11.0.0",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5"
  }
}
